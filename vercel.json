{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,backend/.venv/**,backend/data/**,**/*.swp}"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/memory", "destination": "/api/memory" },
    { "source": "/memory/history", "destination": "/api/memory/history" },
    { "source": "/chat", "destination": "/api/chat" },
    { "source": "/transcribe", "destination": "/api/transcribe" }
  ]
}
