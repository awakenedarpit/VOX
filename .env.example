# Groq: used server-side only; never put this key in frontend JavaScript.
GROQ_API_KEY=your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3
# Use auto to prefer OpenAI-compatible credentials, then Groq, then local Ollama.
# Set LLM_PROVIDER to openai, groq, or ollama to force one provider.
LLM_PROVIDER=auto
# 30 messages = 15 user-assistant conversation turns.
VOX_HISTORY_MESSAGES=30
# Bound prompt size while retaining the full local history store.
VOX_HISTORY_CONTEXT_CHARS=12000
# Retry transient 429/5xx/protocol failures from the configured LLM provider.
VOX_UPSTREAM_RETRIES=3
VOX_TIMEZONE=Asia/Kolkata
# Optional: SerpApi Google Shopping results with retailer, price, and listing URLs.
SERPAPI_API_KEY=your_serpapi_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-5-mini
GROQ_LLM_MODEL=openai/gpt-oss-20b

RIME_API_KEY=your_rime_api_key_here
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_MODEL=coda
RIME_SPEAKER=celeste
# Use auto to select the strongest compatible model already installed in Ollama.
OLLAMA_MODEL=auto
