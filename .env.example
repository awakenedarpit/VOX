# Groq: used server-side only; never put this key in frontend JavaScript.
GROQ_API_KEY=your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3
# Set LLM_PROVIDER=groq for a stronger hosted model, or keep ollama for local inference.
LLM_PROVIDER=ollama
GROQ_LLM_MODEL=openai/gpt-oss-20b

RIME_API_KEY=your_rime_api_key_here
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_MODEL=coda
RIME_SPEAKER=celeste
# Use auto to select the strongest compatible model already installed in Ollama.
OLLAMA_MODEL=auto
